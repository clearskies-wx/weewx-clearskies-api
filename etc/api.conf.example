# weewx-clearskies-api configuration example
# Copy to /etc/weewx-clearskies/api.conf and edit as needed.
#
# SECRETS DO NOT BELONG HERE. Use /etc/weewx-clearskies/secrets.env (mode 0600).
# Naming convention: WEEWX_CLEARSKIES_<DOMAIN>_<FIELD>
#   e.g. WEEWX_CLEARSKIES_PROXY_SECRET=<32-byte hex from `openssl rand -hex 32`>
#        WEEWX_CLEARSKIES_DB_USER=clearskies_ro
#        WEEWX_CLEARSKIES_DB_PASSWORD=<password>
#
# Per ADR-027: any leaf key matching _(KEY|SECRET|TOKEN|PASSWORD) in this
# file will cause the service to refuse to start with a FATAL log message.
#
# Format: ConfigObj/INI. Section syntax [section], nested [[subsection]].
# Re-running the configuration UI (weewx-clearskies-config) preserves
# content below the MANAGED REGION END marker.
#
# Managed by weewx-clearskies-config on YYYY-MM-DD.
# MANAGED REGION BEGIN


[api]
# Bind host for the public API listener.
# Default 127.0.0.1 per ADR-037 (loopback, behind a reverse proxy).
# For cross-host deploys: set to a LAN IP or hostname. The service then
# also requires WEEWX_CLEARSKIES_PROXY_SECRET to be set in secrets.env.
# Hostname values are resolved via socket.getaddrinfo (IPv4 + IPv6).
bind_host = 127.0.0.1

# Bind port for the public API. Default 8765.
bind_port = 8765

# Maximum request body size in bytes. Default 1 MiB (1048576).
# Raise this only if /content/about or /content/legal payloads exceed 1 MiB.
# Returns 413 application/problem+json when exceeded.
max_request_bytes = 1048576

# Additional CORS origins beyond the default same-origin.
# Leave empty for same-origin-only (default, recommended when proxy serves
# SPA and API from the same domain per ADR-037).
# For cross-origin dashboard deploys, list allowed origins one per line or
# comma-separated: cors_origins = https://dashboard.example.com
cors_origins =


[health]
# Bind host for the health check port. Default loopback per ADR-030.
# Health port is SEPARATE from the public API port so probes don't
# pollute access logs and don't require authentication.
bind_host = 127.0.0.1

# Bind port for /health/live and /health/ready. Default 8081 per ADR-030.
bind_port = 8081

# Enable Prometheus /metrics endpoint on the health port. Default false.
# Set to true to allow Prometheus to scrape metrics at
# https://<health_host>:<health_port>/metrics (ADR-031).
# Override with CLEARSKIES_METRICS_ENABLED=true env var (takes priority over
# this setting).
metrics_enabled = false


[logging]
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default INFO. Override with CLEARSKIES_LOG_LEVEL env var per ADR-029.
# DEBUG is a firehose — enable per-incident only.
level = INFO


[ratelimit]
# Requests per minute per IP for unauthenticated paths.
# Default 60. Bypassed when X-Clearskies-Proxy-Auth is valid.
# IMPORTANT: In-process storage only (single-worker). Multi-worker deploys
# need Redis (set CLEARSKIES_CACHE_URL). See security baseline §8.
requests_per_minute = 60

# Window size in seconds. Default 60 (1 minute).
window_seconds = 60


[database]
# Database type: sqlite or mysql.
# Default sqlite (matches most weewx installs).
kind = sqlite

# For sqlite: path to the weewx .sdb file.
path = /var/lib/weewx/weewx.sdb

# For mysql: connection details.
# Credentials come from WEEWX_CLEARSKIES_DB_USER / WEEWX_CLEARSKIES_DB_PASSWORD env vars.
# host = 127.0.0.1
# port = 3306
# name = weewx

# Connection pool size for mysql/mariadb (SQLite uses NullPool regardless).
# Raise if you see "QueuePool limit of size 5 overflow 10 reached" in the logs.
# pool_size = 5
#
# Maximum overflow connections beyond pool_size. mysql/mariadb only.
# max_overflow = 10

# MANAGED REGION END
# Free-form region below — the configuration UI does not touch this.


[station]
# Default locale for the dashboard. The dashboard uses this as the initial
# language, with browser preference as a fallback.
# Supported: en, de, es, fil, fr, it, ja, nl, pt-PT, pt-BR, ru, zh-CN, zh-TW
# Override with CLEARSKIES_DEFAULT_LOCALE env var (ADR-021).
# default_locale = en


[weewx]
# Path to weewx.conf. The API reads station metadata (location, lat/lon,
# altitude, timezone) from this file at startup. Change only when running
# the API on a separate host from weewx, or when weewx.conf is not at
# the stock Debian path.
# config_path = /etc/weewx/weewx.conf

# Directory containing NOAA text reports generated by weewx.
# reports_directory = /var/www/html/weewx/NOAA


[conditions]
# Controls the Current Conditions text on the dashboard.
# "auto" (default) — blends local sensor data with provider conditions
# "provider" — uses provider conditions text verbatim
# "off" — no weatherText field on observations
# engine = auto

# Haze detection toggle (ADR-067). Set to false to disable entirely.
# haze_detection = true

# AQI provider override for haze PM confirmation. Inherits from [aqi] if absent.
# haze_aqi_provider =

# Auto-calibration tuning (ADR-068).
# calibration_percentile = 0.92    # range: 0.90-0.95
# calibration_window_days = 90     # range: 30-365
# calibration_min_samples = 22     # range: 10-100

# Hygroscopic correction exponent gamma (Hanel 1976). Advanced override.
# gamma = 0.45                     # range: 0.1-1.0


[cache_warmer]
# Background pre-computation of slow endpoints (ADR-045).
# A daemon thread pre-computes records (all-time + YTD) and almanac
# (sun-times, moon-phases) on configurable intervals and stores results in the
# ADR-017 CacheBackend.  Endpoint handlers return the cached result in <10ms.
# First warm runs synchronously at startup before the server begins accepting
# requests.
#
# enabled = true
#
# How often to re-warm the /records endpoints (seconds).  Default 1800 (30 min).
# records_interval_seconds = 1800
#
# How often to re-warm the /almanac/sun-times and /almanac/moon-phases endpoints
# (seconds).  Almanac data changes slowly — default 21600 (6 hours).
# almanac_interval_seconds = 21600
#
# How often to re-warm the /aqi/history endpoint (seconds).  Default 1800 (30 min).
# aqi_history_interval_seconds = 1800
#
# How often to re-warm the /climatology/monthly endpoint (seconds).  Default 21600 (6 h).
# climatology_interval_seconds = 21600
#
# How often to re-warm the /almanac/planets endpoint (seconds).  Default 21600 (6 h).
# planets_interval_seconds = 21600
#
# How often to re-warm the /almanac/eclipses endpoint (seconds).  Default 86400 (24 h).
# eclipses_interval_seconds = 86400
#
# How often to re-warm the /almanac/meteor-showers endpoint (seconds).  Default 86400 (24 h).
# meteor_showers_interval_seconds = 86400
#
# How often to re-warm the /earthquakes/faults endpoint (seconds).  Default 21600 (6 h).
# faults_interval_seconds = 21600


[branding]
# Site branding (ADR-022).
# Human-readable station name shown in the dashboard title bar.
# site_title = My Weather Station
#
# Accent colour — one of: blue, teal, indigo, purple, green, amber.
# accent = blue
#
# Default theme mode for new visitors:
#   light | dark | auto-os | auto-sunrise-sunset
# default_theme_mode = auto-os
#
# URL to the logo image for light backgrounds.  Leave empty for no custom logo.
# logo_light_url =
#
# URL to the logo image for dark backgrounds.  Falls back to logo_light_url when empty.
# logo_dark_url =
#
# URL to the site favicon.  Leave empty to use the default Clear Skies favicon.
# favicon_url =
#
# URL to an operator-supplied custom stylesheet.  Leave empty for none.
# custom_css_url =


[social]
# Social media links shown in the dashboard footer.
# Leave any URL empty to hide that icon.
# facebook_url =
# twitter_url =
# instagram_url =
# youtube_url =


[earthquakes]
# Earthquake data configuration (ADR-040).
# provider: data source — usgs | geonet | emsc | renass (all keyless).
# provider = usgs

# Default search radius in km from station lat/lon.
# Override per-request with ?radius_km.  Default 100.
# default_radius_km = 100

# Minimum magnitude to include when ?minmagnitude is not supplied.
# Applied post-cache per ADR-017.  Default 2.0.
# min_magnitude = 2.0

# Lookback window in days used to compute starttime when ?from is not supplied.
# Prevents open-ended queries against upstream providers.  Default 7.
# default_days = 7


[forecast_correction]
# Forecast temperature correction engine (ADR-079).
# Collects forecast-observation pairs and trains a Random Forest model
# to correct systematic forecast bias.  Provider-agnostic.
#
# enabled = false               # Apply corrections to forecast temps
# collection_enabled = true     # Collect forecast-observation pairs
# retrain_schedule = daily      # daily | weekly | manual
# retrain_day = 0               # Day of week for weekly retrain (0=Mon, 6=Sun)
# min_samples = 500             # Minimum pairs before first training
# retention_years = 3           # Rolling data retention window
# db_path = /etc/weewx-clearskies/forecast_correction.db
# model_path = /etc/weewx-clearskies/forecast_correction_model.pkl


[marine]
# Marine/coastal locations (ADR-083). This entire section is additive and
# OPTIONAL — its absence has zero impact on the rest of the API: no marine
# provider modules register, no /api/v1/marine|tides|surf|fishing|beach-safety
# endpoints appear, and the dashboard shows no Marine nav item. Requires
# eccodes for the NWPS nearshore provider (see OPERATIONS-MANUAL "eccodes
# native dependency"); NWPS degrades gracefully to WaveWatch III offshore
# data when eccodes is missing or NWPS itself is unavailable.
#
# Full field reference (valid values, required/optional): OPERATIONS-MANUAL.md
# "Marine location configuration". Uncomment and adapt the example below —
# each location is its own [[[<location_id>]]] sub-section under [[locations]].
# <location_id> must be a lowercase slug: ^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$
#
# [[locations]]
#   [[[wrightsville_beach]]]
#     # Display name shown on the dashboard.
#     name = Wrightsville Beach
#
#     # Coordinates, decimal degrees. lat in [-90, 90], lon in [-180, 180].
#     lat = 34.2085
#     lon = -77.7964
#
#     # Which activity tabs to enable for this location. 1-4 of:
#     # marine (boating), surf, fishing, beach_safety.
#     activities = marine, surf, fishing, beach_safety
#
#     # NDBC buoy station id(s) — nearest first. Discover via
#     # GET /setup/marine/discover-stations (wizard) or
#     # https://www.ndbc.noaa.gov/activestations.xml (manual). Only the
#     # first id is used per fetch; list additional ids for future fallback.
#     ndbc_station_ids = 41110, 41037
#
#     # NOAA CO-OPS tide/water-level station id(s) — nearest first.
#     # Discover the same way as ndbc_station_ids.
#     coops_station_ids = 8658163
#
#     # NWS coastal marine zone id (prefix AMZ/GMZ/PZZ/ANZ/PKZ/PHZ + 3 digits).
#     # Powers the NWS marine zone text forecast (nws_marine provider).
#     nws_marine_zone_id = AMZ250
#
#     # NWPS WFO domain (3-letter code) and computational grid (CG1-CG5).
#     # Auto-determined from coordinates at setup/apply time — set manually
#     # only when overriding the auto-resolved value.
#     nwps_wfo = ILM
#     nwps_cg_grid = CG1
#
#     # --- Surf sub-block: required when "surf" is in activities above ---
#     [[[[surf]]]]
#       # Compass direction the beach faces, degrees [0, 360).
#       beach_facing_degrees = 135
#
#       # Seabed composition: sand | rock | coral_reef | mixed.
#       bottom_type = sand
#
#       # Coastal morphology: point_break | bay_break | headland | straight_beach.
#       topographic_feature = straight_beach
#
#       # Which compass directions' swell reaches this spot (all 8 required;
#       # unlisted directions default to false).
#       directional_exposure = N:false, NE:false, E:true, SE:true, S:true, SW:true, W:false, NW:false
#
#       # Optional: nearby coastal structures affecting wave transmission.
#       # Uncomment and repeat [[[[[<structure_id>]]]]] blocks as needed.
#       # [[[[[jetty_north]]]]]
#       #   # jetty | pier | breakwater | seawall | groin
#       #   type = jetty
#       #   # impermeable | semi_permeable | permeable
#       #   material = semi_permeable
#       #   length_m = 150
#       #   bearing_degrees = 90
#       #   distance_m = 400
#
#     # --- Fishing sub-block: required when "fishing" is in activities above ---
#     [[[[fishing]]]]
#       # Primary target category: saltwater_inshore | bottom_fish |
#       # freshwater_sport | salmonids. species/biogeographic_region are
#       # auto-populated from this + coordinates — do not set manually.
#       target_category = saltwater_inshore
#
#     # --- Beach safety sub-block: optional even when "beach_safety" is
#     # in activities above (external_links has no required fields) ---
#     [[[[beach_safety]]]]
#       # Operator-provided informational links shown on the beach safety
#       # page (state water-quality dashboards, lifeguard schedules, etc.).
#       # Repeat [[[[[<link_id>]]]]] blocks as needed.
#       [[[[[external_links]]]]]
#         [[[[[[water_quality]]]]]]
#           label = NC Beach Water Quality
#           url = https://ncdeq.gov/beach-water-quality

